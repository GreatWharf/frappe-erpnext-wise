{
  "doctype": "DocType",
  "name": "Wise Connection",
  "module": "Wise Bank Feed",
  "autoname": "hash",
  "engine": "InnoDB",
  "fields": [
    {
      "fieldname": "connection_name",
      "label": "Connection Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "options": "Company",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "environment",
      "label": "Environment",
      "fieldtype": "Select",
      "options": "Production\nSandbox",
      "default": "Production",
      "reqd": 1
    },
    {
      "fieldname": "api_token",
      "label": "Api Token",
      "fieldtype": "Password",
      "reqd": 1
    },
    {
      "fieldname": "profile_id",
      "label": "Profile Id",
      "fieldtype": "Data",
      "description": "Use Discover profiles after saving."
    },
    {
      "fieldname": "mode",
      "label": "Mode",
      "fieldtype": "Select",
      "options": "Activity Review\nStatements",
      "default": "Activity Review",
      "reqd": 1,
      "description": "Activity Review syncs summaries for review. Statements automatically imports authoritative booked lines when API access is available. Immutable after source data exists."
    },
    {
      "fieldname": "enabled",
      "label": "Enabled",
      "fieldtype": "Check"
    },
    {
      "fieldname": "start_date",
      "label": "Start Date",
      "fieldtype": "Date",
      "reqd": 1
    },
    {
      "fieldname": "timezone",
      "label": "Timezone",
      "fieldtype": "Data",
      "default": "Europe/London",
      "reqd": 1
    },
    {
      "fieldname": "cursor_at",
      "label": "Cursor At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "audit_at",
      "label": "Audit At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "last_success",
      "label": "Last Success",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Small Text",
      "read_only": 1
    },
    {
      "fieldname": "profile_key",
      "label": "Profile Key",
      "fieldtype": "Data",
      "unique": 1,
      "hidden": 1,
      "read_only": 1
    }
  ],
  "field_order": [
    "connection_name",
    "company",
    "environment",
    "api_token",
    "profile_id",
    "mode",
    "enabled",
    "start_date",
    "timezone",
    "cursor_at",
    "audit_at",
    "last_success",
    "status",
    "profile_key"
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "report": 1,
      "export": 1,
      "create": 1,
      "write": 1,
      "delete": 1
    }
  ],
  "track_changes": 0,
  "sort_field": "modified",
  "sort_order": "DESC"
}
